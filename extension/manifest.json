{
  "manifest_version": 3,
  "name": "Chess Bot Hint (Stockfish)",
  "version": "0.5.1",
  "description": "Стрелка лучшего хода Stockfish, оценка позиции и разбор ходов как на chess.com. Сейфмод — только игры с ботами chess.com.",
  "browser_specific_settings": {
    "gecko": { "id": "chess-hint@local", "strict_min_version": "115.0" }
  },
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://www.chess.com/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["chess.js", "review.js", "openings.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["analysis-icons/*.svg"], "matches": ["https://www.chess.com/*"] }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Chess Bot Hint" },
  "options_ui": { "page": "popup.html", "open_in_tab": true }
}
